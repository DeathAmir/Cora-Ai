CORA_APP_NAME=Cora AI
CORA_APP_URL=http://localhost/Cora-Ai
CORA_ENV=production
CORA_DEBUG=0

CORA_DB_HOST=127.0.0.1
CORA_DB_PORT=3306
CORA_DB_NAME=coradb
CORA_DB_USER=root
CORA_DB_PASS=

# Hugging Face Inference Providers
CORA_HF_TOKEN=hf_your_token_here
CORA_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct:cheapest
CORA_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
CORA_AI_TIMEOUT=150

# Local app quotas (per signed-in user / day)
CORA_DAILY_CHAT_LIMIT=60
CORA_DAILY_IMAGE_LIMIT=6
