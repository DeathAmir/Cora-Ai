CORA_APP_NAME=Cora AI
CORA_APP_URL=http://localhost/Cora-Ai
CORA_ENV=production
CORA_DEBUG=0

CORA_DB_HOST=127.0.0.1
CORA_DB_PORT=3306
CORA_DB_NAME=coradb
CORA_DB_USER=root
CORA_DB_PASS=

# ollama | openai_compatible
CORA_AI_PROVIDER=ollama
CORA_AI_BASE_URL=http://127.0.0.1:11434
CORA_AI_API_KEY=
CORA_TEXT_MODEL=qwen2.5:7b
CORA_IMAGE_MODEL=gpt-image-1
CORA_AI_TIMEOUT=120

# For an OpenAI-compatible server, for example:
# CORA_AI_PROVIDER=openai_compatible
# CORA_AI_BASE_URL=https://your-provider.example
# CORA_AI_API_KEY=your-secret-key
# CORA_TEXT_MODEL=your-chat-model
# CORA_IMAGE_MODEL=your-image-model
